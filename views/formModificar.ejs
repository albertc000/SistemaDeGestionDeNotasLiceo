<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Modificar Estudiante</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <aside class="sidebar" id="sidebar">
        <div class="btn-close-sidebar" id="closeSidebar">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <path d="M18 6L6 18M6 6l12 12"></path>
            </svg>
        </div>

        <a href="/inicio" class="brand">
            <div class="brand-logo">
                <svg class="w-6 h-6 text-gray-800 dark:text-white" aria-hidden="true" xmlns="http://www.w3.org/2000/svg"
                    width="24" height="24" fill="currentColor" viewBox="0 0 24 24">
                    <path fill-rule="evenodd"
                        d="M12 2a10 10 0 1 0 10 10A10.011 10.011 0 0 0 12 2Zm0 5a3 3 0 1 1-3 3 3 3 0 0 1 3-3Zm0 12a7 7 0 0 1-5.83-3.13C6.22 14.59 9.06 14 12 14s5.78.59 5.83 1.87A7 7 0 0 1 12 19Z"
                        clip-rule="evenodd" />
                </svg>
            </div>
            <h2>Liceo "Andres Bello"</h2>
        </a>

        <ul class="nav-list">
            <li class="nav-item">
                <a href="/inicio" class="nav-link">
                    <svg id="icono" class="w-[34px] h-[34px] text-gray-800 dark:text-white" aria-hidden="true"
                        xmlns="http://www.w3.org/2000/svg" width="34" height="34" fill="none" viewBox="0 0 24 24">
                        <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="m4 12 8-8 8 8M6 10.5V19a1 1 0 0 0 1 1h3v-3a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v3h3a1 1 0 0 0 1-1v-8.5" />
                    </svg>
                    Inicio
                </a>
            </li>
            <li class="nav-item">
                <a href="/listado" class="nav-link active">
                    <svg id="icono" class="w-6 h-6 text-gray-800 dark:text-white" aria-hidden="true"
                        xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24">
                        <path stroke="currentColor" stroke-width="2"
                            d="M7 17v1a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1v-1a3 3 0 0 0-3-3h-4a3 3 0 0 0-3 3Zm8-9a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
                    </svg>
                    Estudiantes
                </a>
            </li>
            <li class="nav-item">
                <a href="/listadoProfesores" class="nav-link">
                    <svg id="icono" class="w-6 h-6 text-gray-800 dark:text-white" aria-hidden="true"
                        xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24">
                        <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M14.6144 7.19994c.3479.48981.5999 1.15357.5999 1.80006 0 1.6569-1.3432 3-3 3-1.6569 0-3.00004-1.3431-3.00004-3 0-.67539.22319-1.29865.59983-1.80006M6.21426 6v4m0-4 6.00004-3 6 3-6 2-2.40021-.80006M6.21426 6l3.59983 1.19994M6.21426 19.8013v-2.1525c0-1.6825 1.27251-3.3075 2.95093-3.6488l3.04911 2.9345 3-2.9441c1.7026.3193 3 1.9596 3 3.6584v2.1525c0 .6312-.5373 1.1429-1.2 1.1429H7.41426c-.66274 0-1.2-.5117-1.2-1.1429Z" />
                    </svg>
                    Profesores
                </a>
            </li>
            <li class="nav-item">
                <a href="/secciones" class="nav-link">
                    <svg id="icono" class="w-6 h-6 text-gray-800 dark:text-white" aria-hidden="true"
                        xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24">
                        <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M3 19V6a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v13M3 19h6m-6 0a1 1 0 0 0 1 1h4a1 1 0 0 0 1-1m0 0V9a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v10M9 19h6m-6 0a1 1 0 0 0 1 1h4a1 1 0 0 0 1-1m0 0V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v15m-6 0h6m-6 0a1 1 0 0 0 1 1h4a1 1 0 0 0 1-1" />
                    </svg>
                    Secciones
                </a>
            </li>
        </ul>

        <div class="sidebar-footer">
            <a onclick="cerrarSesion()" class="nav-link" style="margin-top: 1rem;">
                <svg id="icono" class="w-[34px] h-[34px] text-gray-800 dark:text-white" aria-hidden="true"
                    xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24">
                    <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M5 12h14M5 12l4-4m-4 4 4 4" />
                </svg>
                Salir
            </a>
        </div>
    </aside>

    <main class="main-content">
        <header style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem; flex-wrap: wrap; gap: 1rem;">
            <div>
                <h1 style="font-size: 2rem; background: none; -webkit-text-fill-color: initial;">Modificar Ficha del Estudiante</h1>
                <p style="color: #64748b; margin-top: 0.3rem;">Actualice los datos personales, de contacto y el aula asignada</p>
            </div>
            <div style="display: flex; gap: 0.75rem; align-items: center; flex-wrap: wrap;">
                <a href="/estudiante/<%= cedula %>/notas<%= typeof fromUrl !== 'undefined' && fromUrl !== '/listado' ? '?from=' + encodeURIComponent(fromUrl) : '' %>" class="btn-secondary-link">
                    <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                        <polyline points="14 2 14 8 20 8"/>
                        <line x1="16" y1="13" x2="8" y2="13"/>
                        <line x1="16" y1="17" x2="8" y2="17"/>
                        <polyline points="10 9 9 9 8 9"/>
                    </svg>
                    <span>Gestionar Notas</span>
                </a>
                <a href="<%= typeof fromUrl !== 'undefined' ? fromUrl : '/listado' %>" class="btn-secondary-link">
                    <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
                    </svg>
                    <span>Volver<%= typeof fromUrl !== 'undefined' && fromUrl.startsWith('/seccion') ? ' a la Sección' : '' %></span>
                </a>
            </div>
        </header>

        <div style="max-width: 800px; width: 100%;">
            
            <div class="stat-card3" style="width: 100%;">
                <div id="mensaje-error" style="display: none; padding: 0.8rem; margin-bottom: 1rem; background-color: #fee2e2; color: #991b1b; border-radius: 8px; border: 1px solid #f87171;">
                </div>
                <div class="minimalist-form-container">
                    <form action="/editarEstudiante?_method=PUT" method="POST" id="formEditar">
                        <h3 style="margin-bottom: 1.2rem; text-align: left; font-size: 1.3rem;">Información del Alumno</h3>
                        
                        <div class="form-row">
                            <div class="form-group">
                                <label for="cedula" style="margin-bottom: 0.5rem; text-align: left; font-size: 1rem;">Cédula de Identidad (No modificable)</label>
                                <input type="text" id="cedula" name="cedula" required readonly value="<%= cedula %>" style="background: #f1f5f9; cursor: not-allowed;">
                            </div>
                            <div class="form-group">
                                <label for="genero" style="margin-bottom: 0.5rem; text-align: left; font-size: 1rem;">Género</label>
                                <select id="genero" name="genero">
                                    <option value="M" <%= typeof genero !== 'undefined' && genero === 'M' ? 'selected' : '' %>>Masculino</option>
                                    <option value="F" <%= typeof genero !== 'undefined' && genero === 'F' ? 'selected' : '' %>>Femenino</option>
                                </select>
                            </div>
                        </div>

                        <div class="form-row">
                            <div class="form-group">
                                <label for="nombre" style="margin-bottom: 0.5rem; text-align: left; font-size: 1rem;">Primer Nombre</label>
                                <input type="text" id="nombre" name="nombre" required minlength="2" value="<%= nombre %>">
                            </div>
                            <div class="form-group">
                                <label for="seg_nombre" style="margin-bottom: 0.5rem; text-align: left; font-size: 1rem;">Segundo Nombre</label>
                                <input type="text" id="seg_nombre" name="seg_nombre" value="<%= typeof seg_nombre !== 'undefined' ? seg_nombre : '' %>">
                            </div>
                        </div>

                        <div class="form-row">
                            <div class="form-group">
                                <label for="apellido" style="margin-bottom: 0.5rem; text-align: left; font-size: 1rem;">Primer Apellido</label>
                                <input type="text" id="apellido" name="apellido" required minlength="2" value="<%= apellido %>">
                            </div>
                            <div class="form-group">
                                <label for="seg_apellido" style="margin-bottom: 0.5rem; text-align: left; font-size: 1rem;">Segundo Apellido</label>
                                <input type="text" id="seg_apellido" name="seg_apellido" value="<%= typeof seg_apellido !== 'undefined' ? seg_apellido : '' %>">
                            </div>
                        </div>

                        <div class="form-row">
                            <div class="form-group">
                                <label for="telefono" style="margin-bottom: 0.5rem; text-align: left; font-size: 1rem;">Teléfono de Contacto</label>
                                <input type="text" id="telefono" name="telefono" value="<%= typeof telefono !== 'undefined' ? telefono : '' %>">
                            </div>
                        </div>

                        <div class="form-group">
                            <label for="direccion" style="margin-bottom: 0.5rem; text-align: left; font-size: 1rem;">Dirección de Habitación</label>
                            <input type="text" id="direccion" name="direccion" value="<%= typeof direccion !== 'undefined' ? direccion : '' %>">
                        </div>

                        <div class="form-row">
                            <div class="form-group">
                                <label for="ano" style="margin-bottom: 0.5rem; text-align: left; font-size: 1rem;">Año Escolar</label>
                                <select id="ano" name="ano" required>
                                    <option value="1er Año" <%= typeof ano !== 'undefined' && ano === '1er Año' ? 'selected' : '' %>>1er Año</option>
                                    <option value="2do Año" <%= typeof ano !== 'undefined' && ano === '2do Año' ? 'selected' : '' %>>2do Año</option>
                                    <option value="3er Año" <%= typeof ano !== 'undefined' && ano === '3er Año' ? 'selected' : '' %>>3er Año</option>
                                    <option value="4to Año" <%= typeof ano !== 'undefined' && ano === '4to Año' ? 'selected' : '' %>>4to Año</option>
                                    <option value="5to Año" <%= typeof ano !== 'undefined' && ano === '5to Año' ? 'selected' : '' %>>5to Año</option>
                                </select>
                            </div>
                            <div class="form-group">
                                <label for="seccion" style="margin-bottom: 0.5rem; text-align: left; font-size: 1rem;">Sección</label>
                                <select id="seccion" name="seccion" required>
                                    <option value="A" <%= typeof seccion !== 'undefined' && seccion === 'A' ? 'selected' : '' %>>Sección A</option>
                                    <option value="B" <%= typeof seccion !== 'undefined' && seccion === 'B' ? 'selected' : '' %>>Sección B</option>
                                    <option value="C" <%= typeof seccion !== 'undefined' && seccion === 'C' ? 'selected' : '' %>>Sección C</option>
                                    <option value="D" <%= typeof seccion !== 'undefined' && seccion === 'D' ? 'selected' : '' %>>Sección D</option>
                                </select>
                            </div>
                        </div>

                        <button type="submit" class="act-btn" style="margin-top: 1.5rem; width: 100%;">Actualizar Ficha del Estudiante</button>
                    </form>

                    <form action="/eliminarEstudiante?_method=DELETE" method="POST" id="formEliminar" style="margin-top: 1rem;">
                        <input type="hidden" name="cedula" value="<%= cedula %>">
                        <button type="submit" class="del-btn">Eliminar Estudiante</button>
                    </form>
                </div>
            </div>

        </div>
    </main>

    <script src="/scripts/ui.js"></script>
    <script src="/scripts/formularios.js"></script>
    <script src="/scripts/login.js"></script>
</body>
</html>
