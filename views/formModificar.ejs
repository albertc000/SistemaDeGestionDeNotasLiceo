<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Modificar Estudiante</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="/css/style.css">
    <style>
        .tabla-notas-container {
            width: 100%;
            overflow-x: auto;
            margin-top: 1rem;
            border-radius: 8px;
            border: 1px solid #e2e8f0;
            background: white;
        }
        .tabla-notas {
            width: 100%;
            border-collapse: collapse;
            text-align: left;
            font-size: 0.95rem;
        }
        .tabla-notas th {
            background: #f1f5f9;
            color: #334155;
            padding: 10px 12px;
            font-weight: 600;
            border-bottom: 2px solid #cbd5e1;
        }
        .tabla-notas td {
            padding: 8px 12px;
            border-bottom: 1px solid #e2e8f0;
            vertical-align: middle;
        }
        .tabla-notas input[type="number"] {
            width: 65px;
            padding: 6px 8px;
            text-align: center;
            font-weight: 600;
            border: 1px solid #cbd5e1;
            border-radius: 6px;
            font-size: 0.95rem;
        }
        .tabla-notas input[type="number"]:focus {
            border-color: #3b82f6;
            outline: none;
            box-shadow: 0 0 0 2px rgba(59, 130, 246, 0.2);
        }
        .promedio-materia {
            font-weight: bold;
            color: #0f172a;
        }
    </style>
</head>
<body>
    <aside class="sidebar" id="sidebar">
        <div class="btn-close-sidebar" id="closeSidebar">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M18 6L6 18M6 6l12 12"></path></svg>
        </div>

        <a href="/inicio" class="brand">
            <div class="brand-logo">
                <svg class="w-6 h-6 text-gray-800 dark:text-white" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" viewBox="0 0 24 24">
                    <path fill-rule="evenodd" d="M12 2a10 10 0 1 0 10 10A10.011 10.011 0 0 0 12 2Zm0 5a3 3 0 1 1-3 3 3 3 0 0 1 3-3Zm0 12a7 7 0 0 1-5.83-3.13C6.22 14.59 9.06 14 12 14s5.78.59 5.83 1.87A7 7 0 0 1 12 19Z" clip-rule="evenodd"/>
                </svg>
            </div>
            <h2>Gestión Escolar</h2>
        </a>

        <ul class="nav-list">
            <li class="nav-item">
                <a href="/inicio" class="nav-link ">
                    <svg id="icono" class="w-[34px] h-[34px] text-gray-800 dark:text-white" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="34" height="34" fill="none" viewBox="0 0 24 24">
                        <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m4 12 8-8 8 8M6 10.5V19a1 1 0 0 0 1 1h3v-3a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v3h3a1 1 0 0 0 1-1v-8.5"/>
                    </svg>
                    Inicio
                </a>
            </li>            
            <li class="nav-item">
                <a href="/listado" class="nav-link">
                    <svg id="icono" class="w-6 h-6 text-gray-800 dark:text-white" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24">
                        <path stroke="currentColor" stroke-width="2" d="M7 17v1a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1v-1a3 3 0 0 0-3-3h-4a3 3 0 0 0-3 3Zm8-9a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"/>
                    </svg>
                    Estudiantes
                </a>
            </li>
            <li class="nav-item">
                <a href="/listadoProfesores" class="nav-link">
                    <svg id="icono" class="w-6 h-6 text-gray-800 dark:text-white" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24">
                        <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.6144 7.19994c.3479.48981.5999 1.15357.5999 1.80006 0 1.6569-1.3432 3-3 3-1.6569 0-3.00004-1.3431-3.00004-3 0-.67539.22319-1.29865.59983-1.80006M6.21426 6v4m0-4 6.00004-3 6 3-6 2-2.40021-.80006M6.21426 6l3.59983 1.19994M6.21426 19.8013v-2.1525c0-1.6825 1.27251-3.3075 2.95093-3.6488l3.04911 2.9345 3-2.9441c1.7026.3193 3 1.9596 3 3.6584v2.1525c0 .6312-.5373 1.1429-1.2 1.1429H7.41426c-.66274 0-1.2-.5117-1.2-1.1429Z"/>
                    </svg>
                    Profesores
                </a>
            </li>
        </ul>

        <div class="sidebar-footer">
            <a onclick="cerrarSesion()" class="nav-link" style="margin-top: 1rem;">
                <svg id="icono" class="w-[34px] h-[34px] text-gray-800 dark:text-white" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24">
                    <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M5 12l4-4m-4 4 4 4"/>
                </svg>
                Salir
            </a>
        </div>
    </aside>

    <main class="main-content">
        <header style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem;">
            <div>
                <h1 style="font-size: 2rem; background-clip: unset; -webkit-background-clip: unset; -webkit-text-fill-color: initial; background: none;">Modificar Datos y Calificaciones</h1>
                <p style="color: #64748b; margin-top: 0.5rem;">Actualice la información del estudiante y sus 4 notas por cada materia</p>
            </div>
        </header>

        <div class="dashboard-grid2" style="display: flex; gap: 2rem; align-items: flex-start; max-width: 1300px; width: 100%;">
            
            <div class="stat-card3" style="flex: 1; max-width: 820px;">
                <div id="mensaje-error" style="display: none; padding: 0.8rem; margin-bottom: 1rem; background-color: #fee2e2; color: #991b1b; border-radius: 8px; border: 1px solid #f87171;">
                </div>
                <div class="minimalist-form-container">
                    <form action="/editarEstudiante?_method=PUT" method="POST" id="formEditar">
                        <h3 style="margin-bottom: 1.2rem; text-align: left; font-size: 1.3rem;">Información del Alumno</h3>
                        
                        <div class="form-row">
                            <div class="form-group">
                                <label for="cedula" style="margin-bottom: 0.5rem; text-align: left; font-size: 1rem;">Cédula de Identidad (No modificable)</label>
                                <input type="text" id="cedula" name="cedula" required readonly value="<%= cedula %>">
                            </div>
                            <div class="form-group">
                                <label for="genero" style="margin-bottom: 0.5rem; text-align: left; font-size: 1rem;">Género</label>
                                <select id="genero" name="genero">
                                    <option value="M" <%= typeof genero !== 'undefined' && genero === 'M' ? 'selected' : '' %>>Masculino</option>
                                    <option value="F" <%= typeof genero !== 'undefined' && genero === 'F' ? 'selected' : '' %>>Femenino</option>
                                </select>
                            </div>
                        </div>

                        
                        <div class="form-row">
                            <div class="form-group">
                                <label for="nombre" style="margin-bottom: 0.5rem; text-align: left; font-size: 1rem;">Primer Nombre</label>
                                <input type="text" id="nombre" name="nombre" required value="<%= nombre %>">
                            </div>
                            <div class="form-group">
                                <label for="seg_nombre" style="margin-bottom: 0.5rem; text-align: left; font-size: 1rem;">Segundo Nombre</label>
                                <input type="text" id="seg_nombre" name="seg_nombre" value="<%= typeof seg_nombre !== 'undefined' ? seg_nombre : '' %>">
                            </div>
                        </div>

                        <div class="form-row">
                            <div class="form-group">
                                <label for="apellido" style="margin-bottom: 0.5rem; text-align: left; font-size: 1rem;">Primer Apellido</label>
                                <input type="text" id="apellido" name="apellido" required value="<%= apellido %>">
                            </div>
                            <div class="form-group">
                                <label for="seg_apellido" style="margin-bottom: 0.5rem; text-align: left; font-size: 1rem;">Segundo Apellido</label>
                                <input type="text" id="seg_apellido" name="seg_apellido" value="<%= typeof seg_apellido !== 'undefined' ? seg_apellido : '' %>">
                            </div>
                        </div>

                        <div class="form-row">
                            <div class="form-group">
                                <label for="telefono" style="margin-bottom: 0.5rem; text-align: left; font-size: 1rem;">Teléfono de Contacto</label>
                                <input type="text" id="telefono" name="telefono" value="<%= typeof telefono !== 'undefined' ? telefono : '' %>">
                            </div>
                        </div>

                        <div class="form-group">
                            <label for="direccion" style="margin-bottom: 0.5rem; text-align: left; font-size: 1rem;">Dirección de Habitación</label>
                            <input type="text" id="direccion" name="direccion" value="<%= typeof direccion !== 'undefined' ? direccion : '' %>">
                        </div>

                        <div class="form-row">
                            <div class="form-group">
                                <label for="ano" style="margin-bottom: 0.5rem; text-align: left; font-size: 1rem;">Año Escolar</label>
                                <select id="ano" name="ano" required>
                                    <option value="1er Año" <%= typeof ano !== 'undefined' && ano === '1er Año' ? 'selected' : '' %>>1er Año</option>
                                    <option value="2do Año" <%= typeof ano !== 'undefined' && ano === '2do Año' ? 'selected' : '' %>>2do Año</option>
                                    <option value="3er Año" <%= typeof ano !== 'undefined' && ano === '3er Año' ? 'selected' : '' %>>3er Año</option>
                                    <option value="4to Año" <%= typeof ano !== 'undefined' && ano === '4to Año' ? 'selected' : '' %>>4to Año</option>
                                    <option value="5to Año" <%= typeof ano !== 'undefined' && ano === '5to Año' ? 'selected' : '' %>>5to Año</option>
                                </select>
                            </div>
                            <div class="form-group">
                                <label for="seccion" style="margin-bottom: 0.5rem; text-align: left; font-size: 1rem;">Sección</label>
                                <select id="seccion" name="seccion" required>
                                    <option value="A" <%= typeof seccion !== 'undefined' && seccion === 'A' ? 'selected' : '' %>>Sección A</option>
                                    <option value="B" <%= typeof seccion !== 'undefined' && seccion === 'B' ? 'selected' : '' %>>Sección B</option>
                                    <option value="C" <%= typeof seccion !== 'undefined' && seccion === 'C' ? 'selected' : '' %>>Sección C</option>
                                    <option value="D" <%= typeof seccion !== 'undefined' && seccion === 'D' ? 'selected' : '' %>>Sección D</option>
                                </select>
                            </div>
                        </div>

                        <h3 style="margin-top: 2rem; margin-bottom: 0.5rem; text-align: left; font-size: 1.3rem; border-top: 2px solid #e2e8f0; padding-top: 1.2rem;">
                            Calificaciones por Asignatura (4 Notas por Materia)
                        </h3>
                        <p style="color: #64748b; font-size: 0.9rem; text-align: left; margin-bottom: 1rem;">
                            Ingrese las 4 notas correspondientes a cada materia cursada (escala de 0 a 20 pts).
                        </p>

                        <div class="tabla-notas-container">
                            <table class="tabla-notas">
                                <thead>
                                    <tr>
                                        <th style="min-width: 160px;">Materia</th>
                                        <th style="text-align: center;">Nota 1</th>
                                        <th style="text-align: center;">Nota 2</th>
                                        <th style="text-align: center;">Nota 3</th>
                                        <th style="text-align: center;">Nota 4</th>
                                        <th style="text-align: center;">Promedio</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% if (typeof materiasConNotas !== 'undefined' && materiasConNotas.length > 0) { %>
                                        <% materiasConNotas.forEach(mat => { %>
                                            <tr>
                                                <td>
                                                    <strong><%= mat.nombre %></strong>
                                                </td>
                                                <td style="text-align: center;">
                                                    <input type="number" name="nota_<%= mat.id %>_1" min="0" max="20" step="0.1" value="<%= mat.nota1 %>" class="nota-input" data-materia="<%= mat.id %>">
                                                </td>
                                                <td style="text-align: center;">
                                                    <input type="number" name="nota_<%= mat.id %>_2" min="0" max="20" step="0.1" value="<%= mat.nota2 %>" class="nota-input" data-materia="<%= mat.id %>">
                                                </td>
                                                <td style="text-align: center;">
                                                    <input type="number" name="nota_<%= mat.id %>_3" min="0" max="20" step="0.1" value="<%= mat.nota3 %>" class="nota-input" data-materia="<%= mat.id %>">
                                                </td>
                                                <td style="text-align: center;">
                                                    <input type="number" name="nota_<%= mat.id %>_4" min="0" max="20" step="0.1" value="<%= mat.nota4 %>" class="nota-input" data-materia="<%= mat.id %>">
                                                </td>
                                                <td style="text-align: center;">
                                                    <span class="promedio-materia" id="prom_<%= mat.id %>">
                                                        <%= mat.promedio.toFixed(2) %>
                                                    </span>
                                                </td>
                                            </tr>
                                        <% }); %>
                                    <% } else { %>
                                        <tr>
                                            <td colspan="6" style="text-align: center; color: #64748b; padding: 2rem;">
                                                No se encontraron materias registradas para este grado.
                                            </td>
                                        </tr>
                                    <% } %>
                                </tbody>
                            </table>
                        </div>

                        <button type="submit" class="act-btn" style="margin-top: 1.5rem; width: 100%;">Actualizar Estudiante y Calificaciones</button>
                    </form>

                    <form action="/eliminarEstudiante?_method=DELETE" method="POST" id="formEliminar" style="margin-top: 1rem;">
                        <input type="hidden" name="cedula" value="<%= cedula %>">
                        <button type="submit" class="del-btn">Eliminar Estudiante</button>
                    </form>
                </div>
            </div>

            <div class="stat-card" style="width: 320px; display: flex; flex-direction: column; align-items: flex-start; justify-content: flex-start; padding: 2rem; background: #f8fafc; border-radius: 12px; border: 1px solid #cbd5e1;">
                <h4 style="margin-bottom: 1.2rem; text-align: left; color: #334155; font-size: 1.15rem;">Resumen Académico</h4>
                
                <%
                   let sumaTotal = 0;
                   let cantTotal = 0;
                   if (typeof materiasConNotas !== 'undefined' && materiasConNotas.length > 0) {
                       materiasConNotas.forEach(m => {
                           sumaTotal += m.promedio;
                           cantTotal++;
                       });
                   }
                   let promGen = cantTotal > 0 ? (sumaTotal / cantTotal).toFixed(2) : "0.00";
                   let esAprob = Number(promGen) >= 10;
                %>

                <div style="background: white; padding: 1rem; border-radius: 8px; width: 100%; border: 1px solid #e2e8f0; margin-bottom: 1rem;">
                    <div style="font-size: 0.9rem; color: #64748b;">Promedio General:</div>
                    <div id="promedioGeneralTexto" style="font-size: 2rem; font-weight: bold; color: <%= esAprob ? '#16a34a' : '#dc2626' %>;">
                        <%= promGen %> pts
                    </div>
                </div>

                <div style="background: white; padding: 1rem; border-radius: 8px; width: 100%; border: 1px solid #e2e8f0; margin-bottom: 1rem;">
                    <div style="font-size: 0.9rem; color: #64748b;">Condición Académica:</div>
                    <div id="estadoGeneralTexto" style="font-size: 1.25rem; font-weight: bold; color: <%= esAprob ? '#16a34a' : '#dc2626' %>;">
                        <%= esAprob ? 'Aprobado' : 'Reprobado' %>
                    </div>
                </div>

                <div style="background: white; padding: 1rem; border-radius: 8px; width: 100%; border: 1px solid #e2e8f0;">
                    <div style="font-size: 0.9rem; color: #64748b;">Total Materias:</div>
                    <div style="font-size: 1.25rem; font-weight: bold; color: #0f172a;">
                        <%= typeof materiasConNotas !== 'undefined' ? materiasConNotas.length : 0 %> Asignaturas
                    </div>
                </div>
            </div>

        </div>
    </main>

    <script src="/scripts/ui.js"></script>
    <script src="/scripts/formularios.js"></script>
    <script src="/scripts/login.js"></script>

    <script>
        // Cálculo automático en tiempo real de los promedios al escribir notas
        document.addEventListener('DOMContentLoaded', () => {
            const inputs = document.querySelectorAll('.nota-input');

            function recalcular() {
                const materias = {};
                inputs.forEach(inp => {
                    const idMat = inp.getAttribute('data-materia');
                    if (!materias[idMat]) materias[idMat] = [];
                    const val = parseFloat(inp.value) || 0;
                    materias[idMat].push(val);
                });

                let sumaPromedios = 0;
                let totalMaterias = 0;

                for (const idMat in materias) {
                    const notas = materias[idMat];
                    const suma = notas.reduce((a, b) => a + b, 0);
                    const promMat = (suma / 4).toFixed(2);
                    
                    const spanProm = document.getElementById(`prom_${idMat}`);
                    if (spanProm) {
                        spanProm.textContent = promMat;
                        spanProm.style.color = promMat >= 10 ? '#16a34a' : '#dc2626';
                    }

                    sumaPromedios += parseFloat(promMat);
                    totalMaterias++;
                }

                const promGeneral = totalMaterias > 0 ? (sumaPromedios / totalMaterias).toFixed(2) : "0.00";
                const esAprob = parseFloat(promGeneral) >= 10;

                const promGenEl = document.getElementById('promedioGeneralTexto');
                const estadoEl = document.getElementById('estadoGeneralTexto');

                if (promGenEl) {
                    promGenEl.textContent = `${promGeneral} pts`;
                    promGenEl.style.color = esAprob ? '#16a34a' : '#dc2626';
                }
                if (estadoEl) {
                    estadoEl.textContent = esAprob ? 'Aprobado' : 'Reprobado';
                    estadoEl.style.color = esAprob ? '#16a34a' : '#dc2626';
                }
            }

            inputs.forEach(inp => {
                inp.addEventListener('input', recalcular);
            });
        });
    </script>
</body>
</html>
