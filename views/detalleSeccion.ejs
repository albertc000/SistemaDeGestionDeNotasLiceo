<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= seccion.grado %> Sección "<%= seccion.letra %>" - Detalle</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <aside class="sidebar" id="sidebar">
        <div class="btn-close-sidebar" id="closeSidebar">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M18 6L6 18M6 6l12 12"></path></svg>
        </div>

        <a href="/inicio" class="brand">
            <div class="brand-logo">
                <svg class="w-6 h-6 text-gray-800 dark:text-white" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" viewBox="0 0 24 24">
                    <path fill-rule="evenodd" d="M12 2a10 10 0 1 0 10 10A10.011 10.011 0 0 0 12 2Zm0 5a3 3 0 1 1-3 3 3 3 0 0 1 3-3Zm0 12a7 7 0 0 1-5.83-3.13C6.22 14.59 9.06 14 12 14s5.78.59 5.83 1.87A7 7 0 0 1 12 19Z" clip-rule="evenodd"/>
                </svg>
            </div>
            <h2>Liceo "Andres Bello"</h2>
        </a>

        <ul class="nav-list">
            <li class="nav-item">
                <a href="/inicio" class="nav-link">
                    <svg id="icono" class="w-[34px] h-[34px] text-gray-800 dark:text-white" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="34" height="34" fill="none" viewBox="0 0 24 24">
                        <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m4 12 8-8 8 8M6 10.5V19a1 1 0 0 0 1 1h3v-3a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v3h3a1 1 0 0 0 1-1v-8.5"/>
                    </svg>
                    Inicio
                </a>
            </li>
            <li class="nav-item">
                <a href="/listado" class="nav-link">
                    <svg id="icono" class="w-6 h-6 text-gray-800 dark:text-white" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24">
                        <path stroke="currentColor" stroke-width="2" d="M7 17v1a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1v-1a3 3 0 0 0-3-3h-4a3 3 0 0 0-3 3Zm8-9a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"/>
                    </svg>
                    Estudiantes
                </a>
            </li>
            <li class="nav-item">
                <a href="/listadoProfesores" class="nav-link">
                    <svg id="icono" class="w-6 h-6 text-gray-800 dark:text-white" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24">
                        <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.6144 7.19994c.3479.48981.5999 1.15357.5999 1.80006 0 1.6569-1.3432 3-3 3-1.6569 0-3.00004-1.3431-3.00004-3 0-.67539.22319-1.29865.59983-1.80006M6.21426 6v4m0-4 6.00004-3 6 3-6 2-2.40021-.80006M6.21426 6l3.59983 1.19994M6.21426 19.8013v-2.1525c0-1.6825 1.27251-3.3075 2.95093-3.6488l3.04911 2.9345 3-2.9441c1.7026.3193 3 1.9596 3 3.6584v2.1525c0 .6312-.5373 1.1429-1.2 1.1429H7.41426c-.66274 0-1.2-.5117-1.2-1.1429Z"/>
                    </svg>
                    Profesores
                </a>
            </li>
            <li class="nav-item">
                <a href="/secciones" class="nav-link active">
                    <svg id="icono" class="w-6 h-6 text-gray-800 dark:text-white" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24">
                        <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 19V6a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v13M3 19h6m-6 0a1 1 0 0 0 1 1h4a1 1 0 0 0 1-1m0 0V9a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v10M9 19h6m-6 0a1 1 0 0 0 1 1h4a1 1 0 0 0 1-1m0 0V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v15m-6 0h6m-6 0a1 1 0 0 0 1 1h4a1 1 0 0 0 1-1"/>
                    </svg>
                    Secciones
                </a>
            </li>
        </ul>

        <div class="sidebar-footer">
            <a onclick="cerrarSesion()" class="nav-link" style="margin-top: 1rem;">
                <svg id="icono" class="w-[34px] h-[34px] text-gray-800 dark:text-white" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24">
                    <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M5 12l4-4m-4 4 4 4"/>
                </svg>
                Salir
            </a>
        </div>
    </aside>

    <main class="main-content">
        <header style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 2rem;">
            <div>
                <a href="/secciones" style="color: #0f766e; text-decoration: none; font-weight: 600; display: inline-flex; align-items: center; gap: 0.4rem; margin-bottom: 0.6rem;">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m15 18-6-6 6-6"/></svg>
                    Volver a Secciones
                </a>
                <h1 style="font-size: 2rem; background-clip: unset; -webkit-background-clip: unset; -webkit-text-fill-color: initial; background: none;">
                    <%= seccion.grado %> - Sección "<%= seccion.letra %>"
                </h1>
                <p style="color: #64748b; margin-top: 0.3rem;">Cuerpo docente y nómina de estudiantes matriculados</p>
            </div>
            <div style="display: flex; flex-direction: column; align-items: flex-end; gap: 0.6rem;">
                <div style="color: #0f766e; font-weight: 700; font-size: 0.95rem;">
                    <%= estudiantesInscritos.length %> Estudiantes Inscritos
                </div>
                <a href="/seccion/<%= seccion.id %>/reporte" style="text-decoration: none;">
                    <button type="button" class="btn-cart">
                        <div class="btn-text-content">
                            <svg class="w-6 h-6 text-gray-800 dark:text-white" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24">
                                <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 10V7.914a1 1 0 0 1 .293-.707l3.914-3.914A1 1 0 0 1 9.914 3H18a1 1 0 0 1 1 1v6M5 19v1a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-1M10 3v4a1 1 0 0 1-1 1H5m14 9.006h-.335a1.647 1.647 0 0 1-1.647-1.647v-1.706a1.647 1.647 0 0 1 1.647-1.647L19 12M5 12v5h1.375A1.626 1.626 0 0 0 8 15.375v-1.75A1.626 1.626 0 0 0 6.375 12H5Zm9 1.5v2a1.5 1.5 0 0 1-1.5 1.5v0a1.5 1.5 0 0 1-1.5-1.5v-2a1.5 1.5 0 0 1 1.5-1.5v0a1.5 1.5 0 0 1 1.5 1.5Z"/>
                            </svg>
                            <span>Generar Reporte</span>
                        </div>
                    </button>
                </a>
            </div>
        </header>

        <div class="component-wrapper">

            <div class="section-block-title" style="margin-top: 0.5rem;">
                <h2>Docentes y Materias Asignadas</h2>
            </div>

            <div class="table-container" style="margin-bottom: 2.5rem;">
                <div class="table-wrapper">
                    <table>
                        <thead>
                            <tr>
                                <th scope="col" style="width: 220px;">Materia</th>
                                <th scope="col">Docente Asignado</th>
                                <th scope="col" style="width: 180px;">Teléfono</th>
                                <th scope="col" class="cell-actions" style="width: 120px; text-align: right;">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% materias.forEach(mat => { %>
                                <tr>
                                    <td>
                                        <span style="color: #0f766e; font-weight: 600;">
                                            <%= mat.nombre_materia %>
                                        </span>
                                    </td>
                                    <td>
                                        <% if (mat.cedula_profesor) { %>
                                            <strong><%= mat.nombre_profesor %> <%= mat.apellido_profesor %></strong>
                                            <span style="color: #64748b; font-size: 0.85rem; margin-left: 4px;">(V-<%= mat.cedula_profesor %>)</span>
                                        <% } else { %>
                                            <span style="color: #94a3b8; font-style: italic;">Sin asignar</span>
                                        <% } %>
                                    </td>
                                    <td>
                                        <% if (mat.cedula_profesor && mat.telefono_profesor) { %>
                                            <span style="color: #334155; font-weight: 500;"><%= mat.telefono_profesor %></span>
                                        <% } else { %>
                                            <span style="color: #94a3b8;">-</span>
                                        <% } %>
                                    </td>
                                    <td class="cell-actions" style="width: 120px;">
                                        <div class="actions-container" style="display: flex; justify-content: flex-end; gap: 0.4rem;">
                                            <button type="button" 
                                                    class="action-button btn-edit"
                                                    onclick="abrirModalAsignarProfesor('<%= mat.id_materia %>', '<%= mat.nombre_materia %>')"
                                                    title="<%= mat.cedula_profesor ? 'Cambiar Profesor Asignado' : 'Asignar Profesor' %>">
                                                <svg class="w-6 h-6 text-gray-800 dark:text-white" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" viewBox="0 0 24 24">
                                                    <path fill-rule="evenodd" d="M9 4a4 4 0 1 0 0 8 4 4 0 0 0 0-8Zm-2 9a4 4 0 0 0-4 4v1a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2v-1a4 4 0 0 0-4-4H7Zm8-1a1 1 0 0 1 1-1h1v-1a1 1 0 1 1 2 0v1h1a1 1 0 1 1 0 2h-1v1a1 1 0 1 1-2 0v-1h-1a1 1 0 0 1-1-1Z" clip-rule="evenodd"/>
                                                </svg>

                                            </button>
                                            <% if (mat.cedula_profesor) { %>
                                                <button class="action-button btn-edit" onclick="editarProfesor('<%= mat.cedula_profesor %>')" title="Modificar Datos del Profesor">
                                                    <svg class="w-6 h-6 text-gray-800 dark:text-white" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" viewBox="0 0 24 24">
                                                        <path stroke="currentColor" stroke-width="2" d="M21 12c0 1.2-4.03 6-9 6s-9-4.8-9-6c0-1.2 4.03-6 9-6s9 4.8 9 6Z"/>
                                                        <path stroke="currentColor" stroke-width="2" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"/>
                                                    </svg>
                                                </button>
                                            <% } %>
                                        </div>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="section-block-title">
                <h2>Nómina de Estudiantes</h2>
            </div>

            <div class="search-bar">
                <svg class="search-icon" viewBox="0 0 24 24">
                    <path d="M15.5 14h-.79l-.28-.27A6.471 6.471 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z" />
                </svg>
                <input type="text" id="inputBuscarEstudiante" class="search-input" placeholder="Buscar en esta sección por Cédula, Nombres, Apellidos...">
            </div>

            <div style="margin-bottom: 1.5rem; display: flex; justify-content: flex-end;">
                <button type="button" class="btn-inscribir-seccion" onclick="abrirModalInscribirEstudiante()">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                        <path d="M12 5v14m-7-7h14"/>
                    </svg>
                    <span>Inscribir Estudiante (<%= estudiantesDisponibles.length %> disponibles)</span>
                </button>
            </div>

            <div class="table-container">
                <div class="table-wrapper">
                    <table id="tablaAlumnosSeccion">
                        <thead>
                            <tr>
                                <th scope="col" style="width: 220px;">Cédula</th>
                                <th scope="col">Estudiante</th>
                                <th scope="col" style="width: 180px;">Teléfono</th>
                                <th scope="col" class="cell-actions" style="width: 120px; text-align: right;">Acciones</th>
                            </tr>
                        </thead>
                        <tbody id="cuerpoTablaAlumnos">
                            <% if (estudiantesInscritos.length === 0) { %>
                                <tr>
                                    <td colspan="4" style="text-align: center; color: #94a3b8; padding: 2.5rem;">
                                        No hay estudiantes inscritos en esta sección todavía.
                                    </td>
                                </tr>
                            <% } else { %>
                                <% estudiantesInscritos.forEach(est => { %>
                                    <tr class="fila-estudiante">
                                        <td style="font-weight: 500;">V-<%= est.cedula %></td>
                                        <td style="font-weight: 600;"><%= est.nombre %> <%= est.apellido %></td>
                                        <td><%= est.telefono || '-' %></td>
                                        <td class="cell-actions" style="width: 140px;">
                                            <div class="actions-container" style="display: flex; justify-content: flex-end; gap: 0.4rem;">
                                                <button class="action-button btn-pres" onclick="irACalificaciones('<%= est.cedula %>', '/seccion/<%= seccion.id %>')" title="Gestionar Calificaciones">
                                                    <svg class="w-5 h-5 text-gray-800 dark:text-white" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" viewBox="0 0 24 24">
                                                        <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 3v4a1 1 0 0 1-1 1H5m14-4v16a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V7.414a1 1 0 0 1 .293-.707l4.414-4.414A1 1 0 0 1 10 2h8a1 1 0 0 1 1 1Z"/>
                                                    </svg>
                                                </button>
                                                <button class="action-button btn-edit" onclick="editarEstudiante('<%= est.cedula %>', '/seccion/<%= seccion.id %>')" title="Modificar Datos Personales">
                                                    <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                                        <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
                                                        <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
                                                    </svg>
                                                </button>
                                                <button type="button" 
                                                        class="action-button btn-delete" 
                                                        onclick="desincorporarEstudianteSeccion('<%= seccion.id %>', '<%= est.cedula %>', '<%= est.nombre %> <%= est.apellido %>')" 
                                                        title="Desincorporar de esta Sección">
                                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                        <path stroke-linecap="round" stroke-linejoin="round" d="M13 7a4 4 0 1 1-8 0 4 4 0 0 1 8 0Zm-4 7a6 6 0 0 0-6 6v1h12v-1a6 6 0 0 0-2-4.5M21 11h-6"/>
                                                    </svg>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                <% }) %>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>

        </div>

        <div id="modalAsignarProfesor" class="modal" style="display: none; position: fixed; z-index: 1000; left: 0; top: 0; width: 100%; height: 100%; background: rgba(15, 23, 42, 0.6); backdrop-filter: blur(2px); justify-content: center; align-items: center;">
            <div class="modal-content" style="background: white; padding: 2rem; border-radius: 14px; width: 92%; max-width: 580px; max-height: 85vh; display: flex; flex-direction: column; box-shadow: 0 20px 25px -5px rgba(0,0,0,0.2);">
                
                <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 1.2rem;">
                    <div>
                        <h3 style="font-size: 1.35rem; color: #0f172a; margin: 0; font-weight: 700;">Asignar Profesor</h3>
                        <p style="color: #64748b; margin: 4px 0 0; font-size: 0.9rem;">
                            Materia: <strong id="modalNombreMateria" style="color: #0f766e;"></strong>
                        </p>
                    </div>
                    <button onclick="cerrarModalProfesor()" type="button" style="background: none; border: none; font-size: 1.6rem; cursor: pointer; color: #64748b; line-height: 1;">&times;</button>
                </div>

                <div style="margin-bottom: 1rem; position: relative;">
                    <input type="text" id="buscadorProfesorModal" placeholder="Buscar por Cédula, Nombre o Apellido..." 
                           style="width: 100%; padding: 10px 14px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 0.92rem; outline: none; transition: border-color 0.2s;"
                           onfocus="this.style.borderColor='#0f766e'" onblur="this.style.borderColor='#cbd5e1'">
                </div>

                <div id="listaProfesoresModal" style="flex: 1; overflow-y: auto; display: flex; flex-direction: column; gap: 0.6rem; padding-right: 4px;">
                    
                    <div onclick="seleccionarYGuardarProfesor('')" 
                         class="item-profesor" 
                         style="display: flex; justify-content: space-between; align-items: center; padding: 10px 14px; border: 1px dashed #f87171; border-radius: 8px; cursor: pointer; transition: all 0.2s; background: #fff5f5;"
                         onmouseover="this.style.background='#fee2e2'; this.style.borderColor='#ef4444';"
                         onmouseout="this.style.background='#fff5f5'; this.style.borderColor='#f87171';">
                        <div>
                            <strong style="color: #b91c1c; font-size: 0.92rem;">Sin profesor (Desasignar)</strong>
                            <div style="font-size: 0.8rem; color: #64748b;">Elimina el docente asignado a esta materia</div>
                        </div>
                        <span style="font-size: 0.82rem; color: #b91c1c; font-weight: 600;">Quitar</span>
                    </div>

                    <% listaProfesores.forEach(prof => { %>
                        <div onclick="seleccionarYGuardarProfesor('<%= prof.cedula %>')"
                             class="item-profesor fila-profesor-modal"
                             data-busqueda="<%= prof.cedula.toLowerCase() %> <%= prof.nombre.toLowerCase() %> <%= prof.apellido.toLowerCase() %>"
                             style="display: flex; justify-content: space-between; align-items: center; padding: 10px 14px; border: 1px solid #e2e8f0; border-radius: 8px; cursor: pointer; transition: all 0.2s; background: white;"
                             onmouseover="this.style.background='#f0fdfa'; this.style.borderColor='#0f766e';"
                             onmouseout="this.style.background='white'; this.style.borderColor='#e2e8f0';">
                            <div>
                                <div style="font-weight: 600; color: #1e293b; font-size: 0.95rem;">
                                    <%= prof.apellido %>, <%= prof.nombre %>
                                </div>
                                <div style="font-size: 0.82rem; color: #64748b; margin-top: 2px;">
                                    Cédula: <strong>V-<%= prof.cedula %></strong> <%= prof.telefono ? '• Tel: ' + prof.telefono : '' %>
                                </div>
                            </div>
                            <span style="background: #0f766e; color: white; padding: 5px 12px; border-radius: 6px; font-size: 0.82rem; font-weight: 600;">
                                Seleccionar
                            </span>
                        </div>
                    <% }) %>
                </div>

                <div style="margin-top: 1.2rem; display: flex; justify-content: flex-end;">
                    <button onclick="cerrarModalProfesor()" type="button" style="padding: 8px 16px; background: #e2e8f0; color: #334155; border: none; border-radius: 6px; font-weight: 600; cursor: pointer;">
                        Cancelar
                    </button>
                </div>
            </div>
        </div>

        <form id="formAutoGuardarProfesor" action="/seccion/<%= seccion.id %>/asignarProfesor" method="POST" style="display: none;">
            <input type="hidden" id="modalInputMateria" name="id_materia" value="">
            <input type="hidden" id="modalInputProfesor" name="cedula_profesor" value="">
        </form>

        <div id="modalInscribirEstudiante" class="modal" style="display: none; position: fixed; z-index: 1000; left: 0; top: 0; width: 100%; height: 100%; background: rgba(15, 23, 42, 0.6); backdrop-filter: blur(2px); justify-content: center; align-items: center;">
            <div class="modal-content" style="background: white; padding: 2rem; border-radius: 14px; width: 92%; max-width: 580px; max-height: 85vh; display: flex; flex-direction: column; box-shadow: 0 20px 25px -5px rgba(0,0,0,0.2);">
                
                <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 1.2rem;">
                    <div>
                        <h3 style="font-size: 1.35rem; color: #0f172a; margin: 0; font-weight: 700;">Inscribir Estudiante</h3>
                        <p style="color: #64748b; margin: 4px 0 0; font-size: 0.9rem;">
                            Sección: <strong style="color: #0f766e;"><%= seccion.grado %> Sección "<%= seccion.letra %>"</strong>
                        </p>
                    </div>
                    <button onclick="cerrarModalEstudiante()" type="button" style="background: none; border: none; font-size: 1.6rem; cursor: pointer; color: #64748b; line-height: 1;">&times;</button>
                </div>

                <div style="margin-bottom: 1rem; position: relative;">
                    <input type="text" id="buscadorEstudianteModal" placeholder="Buscar por Cédula, Nombre o Apellido..." 
                           style="width: 100%; padding: 10px 14px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 0.92rem; outline: none; transition: border-color 0.2s;"
                           onfocus="this.style.borderColor='#0f766e'" onblur="this.style.borderColor='#cbd5e1'">
                </div>

                <div id="listaEstudiantesModal" style="flex: 1; overflow-y: auto; display: flex; flex-direction: column; gap: 0.6rem; padding-right: 4px;">
                    <% if (estudiantesDisponibles.length === 0) { %>
                        <div style="text-align: center; color: #64748b; padding: 2.5rem; font-size: 0.95rem;">
                            Todos los estudiantes registrados ya cuentan con sección asignada.
                        </div>
                    <% } else { %>
                        <% estudiantesDisponibles.forEach(est => { %>
                            <div onclick="seleccionarYGuardarEstudiante('<%= est.cedula %>')"
                                 class="item-estudiante fila-estudiante-modal"
                                 data-busqueda="<%= est.cedula.toLowerCase() %> <%= est.nombre.toLowerCase() %> <%= est.apellido.toLowerCase() %>"
                                 style="display: flex; justify-content: space-between; align-items: center; padding: 10px 14px; border: 1px solid #e2e8f0; border-radius: 8px; cursor: pointer; transition: all 0.2s; background: white;"
                                 onmouseover="this.style.background='#f0fdfa'; this.style.borderColor='#0f766e';"
                                 onmouseout="this.style.background='white'; this.style.borderColor='#e2e8f0';">
                                <div>
                                    <div style="font-weight: 600; color: #1e293b; font-size: 0.95rem;">
                                        <%= est.apellido %>, <%= est.nombre %>
                                    </div>
                                    <div style="font-size: 0.82rem; color: #64748b; margin-top: 2px;">
                                        Cédula: <strong>V-<%= est.cedula %></strong>
                                    </div>
                                </div>
                                <span style="background: #0f766e; color: white; padding: 5px 12px; border-radius: 6px; font-size: 0.82rem; font-weight: 600;">
                                    Inscribir
                                </span>
                            </div>
                        <% }) %>
                    <% } %>
                </div>

                <div style="margin-top: 1.2rem; display: flex; justify-content: flex-end;">
                    <button onclick="cerrarModalEstudiante()" type="button" style="padding: 8px 16px; background: #e2e8f0; color: #334155; border: none; border-radius: 6px; font-weight: 600; cursor: pointer;">
                        Cancelar
                    </button>
                </div>
            </div>
        </div>

        <form id="formAutoGuardarEstudiante" action="/seccion/<%= seccion.id %>/asignarEstudiante" method="POST" style="display: none;">
            <input type="hidden" id="modalInputEstudiante" name="cedula_estudiante" value="">
        </form>

    </main>

    <script src="/scripts/ui.js"></script>
    <script src="/scripts/login.js"></script>
    <script src="/scripts/gestorSecciones.js"></script>
</body>
</html>
